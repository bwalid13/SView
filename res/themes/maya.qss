/* =============================================================================
 * Sview Authentic VFX DCC Stylesheet: Autodesk Maya
 * =============================================================================
 * Razor-sharp precision engineering with 0px rectangular bevels, dark charcoal
 * surfaces (#2b2b2b / #323232 / #242424), and signature Maya Teal accents (#26a69a).
 */

/* Global Typography & Base Geometry */
QWidget {
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Roboto", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #d8d8d8;
    background-color: #2b2b2b;
    selection-background-color: #26a69a;
    selection-color: #ffffff;
    border-radius: 0px;
}

QWidget:disabled {
    color: #787878;
}

QMainWindow, QDialog {
    background-color: #2b2b2b;
    color: #d8d8d8;
}

/* Status Bar */
QStatusBar {
    background-color: #2e2e2e;
    color: #26a69a;
    border-top: 1px solid #1c1c1c;
}

/* Menu Bar & Menus */
QMenuBar {
    background-color: #2e2e2e;
    color: #d8d8d8;
    border-bottom: 1px solid #1c1c1c;
    padding: 2px 4px;
    font-size: 13px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 0px;
    color: #d8d8d8;
}

QMenuBar::item:selected {
    background-color: #26a69a;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #1e8279;
    color: #ffffff;
}

QMenu {
    background-color: #2e2e2e;
    color: #d8d8d8;
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    padding: 3px 0;
    font-size: 13px;
}

QMenu::item {
    padding: 5px 24px 5px 18px;
    border-radius: 0px;
}

QMenu::item:selected {
    background-color: #26a69a;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #787878;
}

QMenu::separator {
    height: 1px;
    background-color: #383838;
    margin: 4px 6px;
}

/* ToolBars & Modern Scale ToolButtons */
QToolBar {
    background-color: #323232;
    border: 1px solid #1c1c1c;
    spacing: 3px;
    padding: 2px;
}

QToolButton {
    background-color: transparent;
    color: #d8d8d8;
    border: 1px solid transparent;
    border-radius: 0px;
    min-width: 28px;
    min-height: 28px;
    padding: 3px 6px;
    qproperty-iconSize: 20px 20px;
}

QToolButton:hover {
    background-color: #424242;
    border: 1px solid #26a69a;
    color: #ffffff;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #26a69a;
    color: #ffffff;
    border: 1px solid #1e8279;
}

/* PushButtons (Maya Flat 0px Razor Bevel) */
QPushButton {
    background-color: #363636;
    color: #d8d8d8;
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    padding: 4px 12px;
    min-height: 22px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #424242;
    border-color: #26a69a;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #222222;
    border-color: #1c1c1c;
    color: #ffffff;
}

QPushButton:checked {
    background-color: #26a69a;
    color: #ffffff;
    border-color: #1e8279;
}

QPushButton:disabled {
    background-color: #2e2e2e;
    color: #787878;
    border-color: #242424;
}

/* Input Fields Well (#242424) */
QLineEdit {
    background-color: #242424;
    color: #d8d8d8;
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    padding: 3px 6px;
    min-height: 20px;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #26a69a;
    color: #ffffff;
}

QAbstractSpinBox, QSpinBox, QDoubleSpinBox {
    background-color: #242424;
    color: #d8d8d8;
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    padding: 2px 4px;
    min-height: 20px;
}

QAbstractSpinBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #26a69a;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #323232;
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    width: 16px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #444444;
    border-color: #26a69a;
}

QAbstractSpinBox::up-arrow, QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/themes/themes/images/arrow_up.png);
    width: 8px;
    height: 8px;
}

QAbstractSpinBox::down-arrow, QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/themes/themes/images/arrow_down.png);
    width: 8px;
    height: 8px;
}

/* ComboBoxes */
QComboBox {
    background-color: #323232;
    color: #d8d8d8;
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    padding: 3px 20px 3px 8px;
    min-height: 20px;
    font-size: 13px;
}

QComboBox:hover {
    background-color: #3e3e3e;
    border-color: #26a69a;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid #1c1c1c;
}

QComboBox::down-arrow {
    image: url(:/themes/themes/images/arrow_down.png);
    width: 8px;
    height: 8px;
}

QComboBox QAbstractItemView {
    background-color: #282828;
    color: #d8d8d8;
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    selection-background-color: #26a69a;
    selection-color: #ffffff;
    padding: 2px;
}

/* GroupBox (Maya Flat Zero-Radius) */
QGroupBox {
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    margin-top: 1.5ex;
    font-weight: bold;
    padding: 8px;
}

QGroupBox::title {
    subcontrol-position: top left;
    subcontrol-origin: margin;
    left: 6px;
    padding: 0 4px;
    color: #26a69a;
}

/* TabWidget & TabBar (Flat Zero Border-Radius Rectangular Tabs) */
QTabWidget::pane {
    border: 1px solid #1c1c1c;
    background-color: #323232;
    border-radius: 0px;
}

QTabBar::tab {
    background-color: #2a2a2a;
    color: #8c8c8c;
    border: 1px solid #1c1c1c;
    border-bottom: none;
    border-radius: 0px;
    padding: 4px 10px;
    margin-right: 1px;
    min-height: 18px;
    font-size: 11px;
}

QTabBar::tab:hover {
    background-color: #383838;
    color: #ffffff;
}

QTabBar::tab:selected {
    background-color: #383838;
    color: #ffffff;
    border-top: 2px solid #26a69a;
    font-weight: bold;
}

/* QScrollBar (Maya 12px Razor Rectangular Geometry) */
QScrollBar:horizontal {
    background-color: #242424;
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #3c3c3c;
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #484848;
    border-color: #26a69a;
}

QScrollBar:vertical {
    background-color: #242424;
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #3c3c3c;
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #484848;
    border-color: #26a69a;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: transparent;
    border: none;
    width: 0px;
    height: 0px;
}

/* QSlider (Maya Teal Accent Scrubber) */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #1c1c1c;
    border: 1px solid #141414;
    border-radius: 0px;
}

QSlider::sub-page:horizontal {
    background-color: #26a69a;
    border-radius: 0px;
}

QSlider::handle:horizontal {
    background-color: #d8d8d8;
    border: 1px solid #1c1c1c;
    width: 12px;
    height: 14px;
    margin: -5px 0;
    border-radius: 0px;
}

QSlider::handle:horizontal:hover {
    background-color: #26a69a;
    border-color: #ffffff;
}

/* CheckBox & RadioButton */
QCheckBox, QRadioButton {
    spacing: 6px;
    color: #d8d8d8;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    image: url(:/themes/themes/images/checkbox_unchecked.png);
}

QCheckBox::indicator:checked {
    image: url(:/themes/themes/images/checkbox_checked.png);
}

QCheckBox::indicator:disabled {
    image: url(:/themes/themes/images/checkbox_unchecked_disabled.png);
}

QCheckBox::indicator:checked:disabled {
    image: url(:/themes/themes/images/checkbox_checked_disabled.png);
}

QRadioButton::indicator {
    width: 13px;
    height: 13px;
    image: url(:/themes/themes/images/radio_unchecked.png);
}

QRadioButton::indicator:checked {
    image: url(:/themes/themes/images/radio_checked.png);
}

QRadioButton::indicator:disabled {
    image: url(:/themes/themes/images/radio_unchecked_disabled.png);
}

QRadioButton::indicator:checked:disabled {
    image: url(:/themes/themes/images/radio_checked_disabled.png);
}

/* TreeView, TableView, ListView & Branch Indicators */
QTreeView, QTableView, QListView {
    background-color: #242424;
    alternate-background-color: #2b2b2b;
    color: #d8d8d8;
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    selection-background-color: #26a69a;
    selection-color: #ffffff;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #2e2e2e;
    color: #8c8c8c;
    padding: 4px;
    border: 1px solid #1c1c1c;
    border-radius: 0px;
    font-size: 11px;
    font-weight: bold;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/themes/themes/images/branch_closed.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/themes/themes/images/branch_open.png);
}

/* ToolTip */
QToolTip {
    background-color: #242424;
    color: #ffffff;
    border: 1px solid #26a69a;
    border-radius: 0px;
    padding: 4px 8px;
    font-size: 12px;
}
