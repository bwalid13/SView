/* =============================================================================
 * Sview Authentic VFX DCC Stylesheet: Pixar USDView (OpenUSD)
 * =============================================================================
 * Derived from Pixar Animation Studios OpenUSD usdviewstyle.qss.
 * Features MenV30 pill-geometry scrollbars (12px radii), Presto rounded spinboxes,
 * Pixar golden selection accents (#bd9b54), and warm charcoal studio gray (#383838).
 */

/* Global Typography & Base Widget */
QWidget {
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Roboto", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: rgb(227, 227, 227);
    background-color: rgb(56, 56, 56);
    selection-background-color: rgb(189, 155, 84);
    selection-color: rgb(255, 255, 255);
}

QWidget:disabled {
    color: rgb(122, 122, 122);
}

QMainWindow, QDialog {
    background-color: rgb(46, 46, 46);
    color: rgb(227, 227, 227);
}

/* Status Bar */
QStatusBar {
    background-color: rgb(41, 41, 41);
    color: rgb(222, 158, 46);
    border-top: 1px solid rgb(30, 30, 30);
}

/* Menu Bar & Menus */
QMenuBar {
    background-color: rgb(41, 41, 41);
    color: rgb(227, 227, 227);
    border-bottom: 1px solid rgb(30, 30, 30);
    padding: 2px 4px;
    font-size: 13px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 3px;
    color: rgb(227, 227, 227);
}

QMenuBar::item:selected {
    background-color: rgb(189, 155, 84);
    color: rgb(34, 34, 34);
}

QMenuBar::item:pressed {
    background-color: rgb(222, 158, 46);
    color: rgb(34, 34, 34);
}

QMenu {
    background-color: rgb(41, 41, 41);
    color: rgb(227, 227, 227);
    border: 1px solid rgb(26, 26, 26);
    border-radius: 3px;
    padding: 4px 0;
    font-size: 13px;
}

QMenu::item {
    padding: 5px 24px 5px 18px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: rgb(189, 155, 84);
    color: rgb(34, 34, 34);
}

QMenu::item:disabled {
    color: rgb(122, 122, 122);
}

QMenu::separator {
    height: 1px;
    background-color: rgb(60, 60, 60);
    margin: 4px 8px;
}

/* ToolBars & Modern Scale ToolButtons */
QToolBar {
    background-color: rgb(46, 46, 46);
    border: 1px solid rgb(34, 34, 34);
    spacing: 4px;
    padding: 2px;
}

QToolButton {
    background-color: transparent;
    color: rgb(227, 227, 227);
    border: 1px solid transparent;
    border-radius: 3px;
    min-width: 28px;
    min-height: 28px;
    padding: 3px 6px;
    qproperty-iconSize: 20px 20px;
}

QToolButton:hover {
    background-color: rgb(68, 68, 68);
    border: 1px solid rgb(80, 80, 80);
}

QToolButton:pressed, QToolButton:checked {
    background-color: rgb(189, 155, 84);
    color: rgb(34, 34, 34);
    border: 1px solid rgb(150, 120, 60);
}

/* PushButtons */
QPushButton {
    background-color: rgb(70, 70, 70);
    color: rgb(227, 227, 227);
    border: 1px solid rgb(34, 34, 34);
    border-radius: 3px;
    padding: 4px 12px;
    min-height: 22px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: rgb(85, 85, 85);
    border-color: rgb(189, 155, 84);
}

QPushButton:pressed {
    background-color: rgb(45, 45, 45);
    border-color: rgb(26, 26, 26);
}

QPushButton:checked {
    background-color: rgb(189, 155, 84);
    color: rgb(34, 34, 34);
    border-color: rgb(150, 120, 60);
}

QPushButton:disabled {
    background-color: rgb(48, 48, 48);
    color: rgb(122, 122, 122);
    border-color: rgb(38, 38, 38);
}

/* Input Fields (Pixar Presto Well Geometry) */
QLineEdit {
    background-color: rgb(34, 34, 34);
    color: rgb(227, 227, 227);
    border: 1px solid rgb(26, 26, 26);
    border-top: 2px solid rgb(19, 19, 19);
    border-left: 2px solid rgb(19, 19, 19);
    border-radius: 3px;
    padding: 3px 6px;
    min-height: 20px;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid rgb(189, 155, 84);
}

QAbstractSpinBox, QSpinBox, QDoubleSpinBox {
    background-color: rgb(34, 34, 34);
    color: rgb(227, 227, 227);
    padding: 2px 4px;
    border-radius: 5px;
    border-top: 2px solid rgb(19, 19, 19);
    border-left: 2px solid rgb(19, 19, 19);
    border-right: 1px solid rgb(26, 26, 26);
    border-bottom: 1px solid rgb(26, 26, 26);
    min-height: 20px;
}

QAbstractSpinBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: rgb(189, 155, 84);
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: rgb(46, 46, 46);
    border: none;
    width: 16px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: rgb(65, 65, 65);
}

QAbstractSpinBox::up-arrow, QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/themes/themes/images/arrow_up.png);
    width: 8px;
    height: 8px;
}

QAbstractSpinBox::down-arrow, QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/themes/themes/images/arrow_down.png);
    width: 8px;
    height: 8px;
}

/* ComboBoxes */
QComboBox {
    background-color: rgb(46, 46, 46);
    color: rgb(227, 227, 227);
    border: 1px solid rgb(26, 26, 26);
    border-radius: 3px;
    padding: 3px 20px 3px 8px;
    min-height: 20px;
    font-size: 13px;
}

QComboBox:hover {
    background-color: rgb(58, 58, 58);
    border-color: rgb(189, 155, 84);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid rgb(34, 34, 34);
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QComboBox::down-arrow {
    image: url(:/themes/themes/images/arrow_down.png);
    width: 8px;
    height: 8px;
}

QComboBox QAbstractItemView {
    background-color: rgb(41, 41, 41);
    color: rgb(227, 227, 227);
    border: 1px solid rgb(26, 26, 26);
    selection-background-color: rgb(189, 155, 84);
    selection-color: rgb(34, 34, 34);
    padding: 2px;
}

/* GroupBox (Pixar USDView 5px rounded) */
QGroupBox {
    border: 1px solid rgb(36, 36, 36);
    border-radius: 5px;
    margin-top: 1.5ex;
    font-weight: bold;
    padding: 8px;
}

QGroupBox::title {
    subcontrol-position: top left;
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: rgb(222, 158, 46);
}

/* TabWidget & TabBar */
QTabWidget::pane {
    border: 1px solid rgb(34, 34, 34);
    background-color: rgb(46, 46, 46);
    border-radius: 3px;
}

QTabBar::tab {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(89, 89, 89), stop: 1 rgb(74, 74, 74));
    color: rgb(200, 200, 200);
    border: 1px solid rgb(34, 34, 34);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    padding: 4px 10px;
    margin-right: 2px;
    min-height: 18px;
    font-size: 11px;
}

QTabBar::tab:hover {
    background: rgb(96, 96, 96);
    color: rgb(255, 255, 255);
}

QTabBar::tab:selected {
    background: rgb(56, 56, 56);
    color: rgb(255, 255, 255);
    border-bottom: 2px solid rgb(189, 155, 84);
    font-weight: bold;
}

/* =========================================================================
 * Pixar MenV30 Geometry QScrollBar (12px Corner Radii)
 * ========================================================================= */
QScrollBar:horizontal {
    background: rgb(42, 42, 42);
    border: 1px solid rgb(42, 42, 42);
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    height: 14px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: rgb(90, 90, 90);
    border: 1px solid rgb(90, 90, 90);
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-top-color: rgb(126, 126, 126);
    min-width: 45px;
}

QScrollBar::handle:horizontal:hover {
    background: rgb(110, 110, 110);
    border-color: rgb(189, 155, 84);
}

QScrollBar:vertical {
    background: rgb(42, 42, 42);
    border: 1px solid rgb(42, 42, 42);
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    width: 14px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: rgb(90, 90, 90);
    border: 1px solid rgb(90, 90, 90);
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-color: rgb(126, 126, 126);
    min-height: 45px;
}

QScrollBar::handle:vertical:hover {
    background: rgb(110, 110, 110);
    border-color: rgb(189, 155, 84);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: transparent;
    border: none;
    width: 0px;
    height: 0px;
}

/* QSlider (Pixar Golden Accent Scrubber) */
QSlider::groove:horizontal {
    height: 6px;
    background-color: rgb(34, 34, 34);
    border: 1px solid rgb(26, 26, 26);
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background-color: rgb(189, 155, 84);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(229, 162, 44), stop:1 rgb(207, 151, 53));
    border: 1px solid rgb(26, 26, 26);
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: rgb(240, 180, 60);
    border-color: rgb(255, 255, 255);
}

/* CheckBox & RadioButton */
QCheckBox, QRadioButton {
    spacing: 6px;
    color: rgb(227, 227, 227);
    font-size: 13px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    image: url(:/themes/themes/images/checkbox_unchecked.png);
}

QCheckBox::indicator:checked {
    image: url(:/themes/themes/images/checkbox_checked.png);
}

QCheckBox::indicator:disabled {
    image: url(:/themes/themes/images/checkbox_unchecked_disabled.png);
}

QCheckBox::indicator:checked:disabled {
    image: url(:/themes/themes/images/checkbox_checked_disabled.png);
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    image: url(:/themes/themes/images/radio_unchecked.png);
}

QRadioButton::indicator:checked {
    image: url(:/themes/themes/images/radio_checked.png);
}

QRadioButton::indicator:disabled {
    image: url(:/themes/themes/images/radio_unchecked_disabled.png);
}

QRadioButton::indicator:checked:disabled {
    image: url(:/themes/themes/images/radio_checked_disabled.png);
}

/* TreeView, TableView, ListView & Branch Indicators */
QTreeView, QTableView, QListView {
    background-color: rgb(41, 41, 41);
    alternate-background-color: rgb(50, 50, 50);
    color: rgb(227, 227, 227);
    border: 1px solid rgb(26, 26, 26);
    selection-background-color: rgb(189, 155, 84);
    selection-color: rgb(34, 34, 34);
    font-size: 13px;
}

QHeaderView::section {
    background-color: rgb(46, 46, 46);
    color: rgb(200, 200, 200);
    padding: 4px;
    border: 1px solid rgb(30, 30, 30);
    font-size: 11px;
    font-weight: bold;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/themes/themes/images/branch_closed.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/themes/themes/images/branch_open.png);
}

/* ToolTip */
QToolTip {
    background-color: rgb(41, 41, 41);
    color: rgb(227, 227, 227);
    border: 1px solid rgb(189, 155, 84);
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 12px;
}
